# Copy to `.env` and fill with real values. `.env` is gitignored.

# Postgres DSN (async driver is added at runtime by infra/db.py)
DATABASE_URL=postgres://lap:lap@localhost:5432/lap

# Redis broker + cache
REDIS_URL=redis://localhost:6379/0

# Clerk backend API key (starts with sk_test_ in dev, sk_live_ in prod)
CLERK_SECRET=sk_test_replace_me

# Stripe secret key (starts with sk_test_ in dev, sk_live_ in prod)
STRIPE_SECRET=sk_test_replace_me

# Stripe Price IDs — created manually in the Stripe dashboard:
#   LAP Monthly      = €15/mo
#   LAP Yearly       = €150/yr
#   Waitlist Founder = €12/mo (founder cohort)
# Format: "price_<id>". Leave empty in dev unless testing checkout.
STRIPE_PRICE_LAP_MONTHLY=
STRIPE_PRICE_LAP_YEARLY=
STRIPE_PRICE_WAITLIST_FOUNDER=
